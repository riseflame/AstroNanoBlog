---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;
const firstDepth = Math.min(...headings.map((heading) => heading.depth));
---

{headings.length > 0 && (
  <details class="article-toc" open>
    <summary>
      <span class="toc-label">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M8 6h12M8 12h12M8 18h12M3 6h1M3 12h1M3 18h1" />
        </svg>
        目录
      </span>
      <svg class="toc-chevron" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="m6 8 4 4 4-4" />
      </svg>
    </summary>
    <nav aria-label="文章目录">
      <ol>
        {headings.map((heading) => (
          <li style={`--level: ${Math.min(heading.depth - firstDepth, 4)}`}>
            <a href={`#${heading.slug}`} data-toc-link>{heading.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  </details>
)}

<style>
  .article-toc {
    --toc-text: #57534e;
    --toc-active: #1c1917;
    --toc-highlight: rgb(120 113 108 / 10%);
    position: fixed;
    top: 8rem;
    left: max(1.25rem, calc(50% - 37.5rem));
    z-index: 40;
    width: 15rem;
    color: var(--toc-text);
    background: rgb(250 250 249 / 65%);
    border: 1px solid rgb(120 113 108 / 16%);
    border-radius: 0.875rem;
    box-shadow: 0 8px 32px rgb(0 0 0 / 4%);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  :global(html.dark) .article-toc {
    --toc-text: #d6d3d1;
    --toc-active: #fafaf9;
    --toc-highlight: rgb(255 255 255 / 8%);
    background: rgb(28 25 23 / 65%);
    border-color: rgb(255 255 255 / 14%);
  }

  .article-toc:not([open]) {
    width: 7.5rem;
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    cursor: pointer;
    list-style: none;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--toc-active);
    user-select: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .toc-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  svg {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .toc-chevron {
    transition: transform 150ms ease;
  }

  [open] .toc-chevron {
    transform: rotate(180deg);
  }

  nav {
    max-height: calc(100dvh - 13rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    padding: 0 0.625rem 0.75rem;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding-left: calc(var(--level) * 0.75rem);
  }

  a {
    display: block;
    padding: 0.5rem 0.625rem;
    border-radius: 0.5rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
    transition: background-color 150ms ease, color 150ms ease;
  }

  a:hover,
  a[aria-current="location"] {
    color: var(--toc-active);
    background: var(--toc-highlight);
  }

  a[aria-current="location"] {
    font-weight: 600;
  }

  a:focus-visible,
  summary:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  :global(article :is(h1, h2, h3, h4, h5, h6)[id]) {
    scroll-margin-top: 6rem;
  }

  :global(html:has(.article-toc)) {
    scroll-behavior: smooth;
  }

  @media (max-width: 1199px) {
    .article-toc,
    .article-toc:not([open]) {
      position: static;
      width: 100%;
      margin-bottom: 2rem;
    }

    nav {
      max-height: 16rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html:has(.article-toc)) {
      scroll-behavior: auto;
    }

    a,
    .toc-chevron {
      transition: none;
    }
  }
</style>

<script>
  let cleanup: (() => void) | undefined;

  function initToc() {
    cleanup?.();
    const toc = document.querySelector<HTMLDetailsElement>(".article-toc");
    if (!toc) return;

    const desktop = window.matchMedia("(min-width: 1200px)");
    toc.open = desktop.matches;
    const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"));
    const sections = links.flatMap((link) => {
      const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
      return heading ? [{ link, heading }] : [];
    });
    const controller = new AbortController();
    let frame = 0;

    function updateActive() {
      frame = 0;
      let active = sections[0];
      for (const section of sections) {
        if (section.heading.getBoundingClientRect().top > 128) break;
        active = section;
      }
      for (const section of sections) {
        if (section === active) section.link.setAttribute("aria-current", "location");
        else section.link.removeAttribute("aria-current");
      }
    }

    function scheduleUpdate() {
      if (!frame) frame = requestAnimationFrame(updateActive);
    }

    window.addEventListener("scroll", scheduleUpdate, { passive: true, signal: controller.signal });
    window.addEventListener("resize", scheduleUpdate, { signal: controller.signal });
    toc.addEventListener("click", (event) => {
      if (!desktop.matches && event.target instanceof Element && event.target.closest("[data-toc-link]")) {
        toc.open = false;
      }
    }, { signal: controller.signal });
    updateActive();

    cleanup = () => {
      controller.abort();
      cancelAnimationFrame(frame);
    };
  }

  initToc();
  document.addEventListener("astro:page-load", initToc);
  document.addEventListener("astro:before-swap", () => cleanup?.());
</script>
